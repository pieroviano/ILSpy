<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ILSpy.Deobfuscation.Plugin</AssemblyName>
    <RootNamespace>ICSharpCode.ILSpy.Deobfuscation</RootNamespace>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <!-- Land next to ILSpy.exe so the *.Plugin.dll scan in AppComposition finds it. -->
    <OutputPath>..\ILSpy\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
	<RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ILSpy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ILSpy\ILSpy.csproj" />
    <ProjectReference Include="..\ICSharpCode.ILSpyX\ICSharpCode.ILSpyX.csproj" />
    <ProjectReference Include="..\ICSharpCode.Decompiler\ICSharpCode.Decompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.Composition.AttributedModel" />
  </ItemGroup>

</Project>
